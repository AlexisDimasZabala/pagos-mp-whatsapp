# Copiar a .env y completar. NUNCA subir .env a GitHub.

# Dominio que apunta al VPS (registro A). Ej: n8n.tudominio.com.ar
DOMAIN=n8n.ejemplo.com.ar
N8N_VERSION=latest

POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
# Generar con: openssl rand -hex 32  (si se pierde, se pierden las credenciales guardadas en n8n)
N8N_ENCRYPTION_KEY=cambiar-por-un-valor-aleatorio

# Mercado Pago -> Tus integraciones -> tu app
# Usar primero las credenciales de PRUEBA (TEST-...).
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxx
# Webhooks -> "Clave secreta" de la app
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# WhatsApp Cloud API (developers.facebook.com -> tu app -> WhatsApp -> API Setup)
# Para producción usar el token permanente de un "System User", no el temporal de 24 h.
WA_TOKEN=EAAG...
WA_PHONE_NUMBER_ID=000000000000000
WA_GRAPH_VERSION=v23.0
# Plantilla de categoría "utility" aprobada por Meta (ver README)
WA_TEMPLATE=aviso_pago_recibido
WA_TEMPLATE_LANG=es_AR
# Número del dueño del negocio, formato internacional sin + ni 15. Ej: 5492954123456
DUENO_WHATSAPP=5492954000000

# ID de la planilla de Google (lo que va entre /d/ y /edit en la URL)
SHEET_ID=1AbCdEf...
